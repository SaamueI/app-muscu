# Copier ce fichier vers .env et remplir avec tes propres identifiants EmailJS
# (dashboard EmailJS > Email Services / Email Templates / Account > General
# et Private Key sous Account > Security). Nécessaire pour "Signaler un bug"
# / "Envoyer une suggestion" (app/feedback.tsx). Sans ce fichier, l'app
# démarre normalement mais l'envoi de feedback échouera silencieusement.
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EXPO_PUBLIC_EMAILJS_PRIVATE_KEY=
